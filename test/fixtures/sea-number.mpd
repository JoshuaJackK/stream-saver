<?xml version="1.0"?>
<MPD xmlns="urn:mpeg:dash:schema:mpd:2011" xmlns:sea="urn:mpeg:dash:schema:sea:2012" type="static" mediaPresentationDuration="PT1M1S" profiles="urn:mpeg:dash:profile:isoff-live:2011">
  <BaseURL>https://northeurope1-mediap.svc.ms/transform/</BaseURL>
  <Period>
    <AdaptationSet mimeType="video/mp4" codecs="avc1.64001F">
      <ContentProtection schemeIdUri="urn:mpeg:dash:sea:2012">
        <sea:SegmentEncryption schemeIdUri="urn:mpeg:dash:sea:aes128-cbc:2013"/>
        <sea:CryptoPeriod IV="0x0123456789ABCDEF0123456789ABCDEF" keyUriTemplate="https://northeurope1-mediap.svc.ms/transform/key?kid=abc"/>
      </ContentProtection>
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1" initialization="v/$RepresentationID$/init.mp4" media="v/$RepresentationID$/seg-$Number%05d$.m4s"/>
      <Representation id="v1" bandwidth="500000" width="1280" height="720"/>
    </AdaptationSet>
    <AdaptationSet mimeType="audio/mp4" codecs="mp4a.40.2">
      <SegmentTemplate timescale="1000" duration="4000" startNumber="1" initialization="a/$RepresentationID$/init.mp4" media="a/$RepresentationID$/seg-$Number%05d$.m4s"/>
      <Representation id="a1" bandwidth="96000"/>
    </AdaptationSet>
  </Period>
</MPD>
